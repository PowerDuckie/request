                    "type": "string"
                  }
                },
                "required": [
                  "city"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MCP JSON-RPC result."
          }
        }
      }
    },
    "/mcp/resources/config": {
      "post": {
        "operationId": "mcp_resource_config",
        "summary": "MCP resource: config",
        "description": "Static demo configuration.",
        "x-protocol": "mcp",
        "x-mcp": {
          "endpoint": "http://127.0.0.1:4200/mcp",
          "method": "resources/read",
          "uri": "config://app",
          "argumentsSchema": {
            "type": "object",
            "properties": {
              "uri": {
                "type": "string"
              }
            },
            "required": [
              "uri"
            ]
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "uri": {
                    "type": "string"
                  }
                },
                "required": [
                  "uri"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MCP JSON-RPC result."
          }
        }
      }
    },
    "/mcp/prompts/summarize": {
      "post": {
        "operationId": "mcp_prompt_summarize",
        "summary": "MCP prompt: summarize",
        "description": "Ask the model to summarize a piece of text.",
        "x-protocol": "mcp",
        "x-mcp": {
          "endpoint": "http://127.0.0.1:4200/mcp",
          "method": "prompts/get",
          "name": "summarize",
          "argumentsSchema": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              }
            },
            "required": [
              "text"
            ]
          },
          "arguments": {
            "text": "string"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MCP JSON-RPC result."
          }
        }
      }
    }
  }
}