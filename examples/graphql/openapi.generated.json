{
  "openapi": "3.2.0",
  "info": {
    "title": "GraphQL Demo",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4100/graphql"
    }
  ],
  "paths": {
    "/graphql/query/user": {
      "post": {
        "operationId": "graphql_query_user",
        "summary": "GraphQL query: user",
        "x-protocol": "graphql",
        "x-graphql": {
          "endpoint": "http://127.0.0.1:4100/graphql",
          "operationType": "query",
          "operationName": "Query_User",
          "query": "query Query_User($id: ID!) {\n  user(id: $id) { id name email role }\n}",
          "variablesSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "GraphQL response envelope (data/errors)."
          }
        }
      }
    },
    "/graphql/query/users": {
      "post": {
        "operationId": "graphql_query_users",
        "summary": "GraphQL query: users",
        "x-protocol": "graphql",
        "x-graphql": {
          "endpoint": "http://127.0.0.1:4100/graphql",
          "operationType": "query",
          "operationName": "Query_Users",
          "query": "query Query_Users($role: Role) {\n  users(role: $role) { id name email role }\n}",
          "variablesSchema": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "ADMIN",
                  "MEMBER",
                  "GUEST"
                ],
                "nullable": true
              }
            },
            "required": []
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "ADMIN",
                      "MEMBER",
                      "GUEST"
                    ],
                    "nullable": true
                  }
                },
                "required": []
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "GraphQL response envelope (data/errors)."
          }
        }
      }
    },
    "/graphql/query/post": {
      "post": {
        "operationId": "graphql_query_post",
        "summary": "GraphQL query: post",
        "x-protocol": "graphql",
        "x-graphql": {
          "endpoint": "http://127.0.0.1:4100/graphql",
          "operationType": "query",
          "operationName": "Query_Post",
          "query": "query Query_Post($id: ID!) {\n  post(id: $id) { id title body author { id name email role } publishedAt }\n}",
          "variablesSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "GraphQL response envelope (data/errors)."
          }
        }
      }
    },
    "/graphql/mutation/createPost": {
      "post": {
        "operationId": "graphql_mutation_createPost",
        "summary": "GraphQL mutation: createPost",
        "x-protocol": "graphql",
        "x-graphql": {
          "endpoint": "http://127.0.0.1:4100/graphql",
          "operationType": "mutation",
          "operationName": "Mutation_CreatePost",
          "query": "mutation Mutation_CreatePost($input: CreatePostInput!) {\n  createPost(input: $input) { id title body author { id name email role } publishedAt }\n}",
          "variablesSchema": {
            "type": "object",
            "properties": {
              "input": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "body": {
