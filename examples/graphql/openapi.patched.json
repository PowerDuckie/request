{
  "openapi": "3.2.0",
  "info": {
    "title": "GraphQL Demo",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4100/graphql"
    }
  ],
  "paths": {
    "/graphql/query/user": {
      "post": {
        "operationId": "graphql_query_user",
        "summary": "GraphQL query: user",
        "x-protocol": "graphql",
        "x-graphql": {
          "endpoint": "http://127.0.0.1:4100/graphql",
          "operationType": "query",
          "operationName": "Query_User",
          "query": "query Query_User($id: ID!) {\n  user(id: $id) { id name email role }\n}",
          "variablesSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "GraphQL response envelope (data/errors).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "user": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "examples": [
                                "1"
                              ]
                            },
                            "name": {
                              "type": "string",
                              "examples": [
                                "Ada Lovelace"
                              ]
                            },
                            "email": {
                              "type": "string",
                              "format": "email",
                              "examples": [
                                "ada@example.com"
                              ]
                            },
                            "role": {
                              "type": "string",
                              "examples": [
                                "ADMIN"
                              ]
                            }
                          },
                          "required": [
                            "id",
                            "name",
                            "email",
                            "role"
                          ]
                        }
                      },
                      "required": [
                        "user"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                },
                "examples": {
                  "capturedSample": {
                    "summary": "Captured from a live call",
                    "value": {
                      "data": {
                        "user": {
                          "id": "1",
                          "name": "Ada Lovelace",
                          "email": "ada@example.com",
                          "role": "ADMIN"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/graphql/query/users": {
      "post": {
        "operationId": "graphql_query_users",
        "summary": "GraphQL query: users",
        "x-protocol": "graphql",
        "x-graphql": {
          "endpoint": "http://127.0.0.1:4100/graphql",
          "operationType": "query",
          "operationName": "Query_Users",
          "query": "query Query_Users($role: Role) {\n  users(role: $role) { id name email role }\n}",
          "variablesSchema": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "ADMIN",
                  "MEMBER",
                  "GUEST"
                ],
                "nullable": true
              }
            },
            "required": []
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "ADMIN",
                      "MEMBER",
                      "GUEST"
                    ],
                    "nullable": true
                  }
                },
                "required": []
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "GraphQL response envelope (data/errors)."
          }
        }
      }
    },
    "/graphql/query/post": {
      "post": {
        "operationId": "graphql_query_post",
        "summary": "GraphQL query: post",
        "x-protocol": "graphql",
        "x-graphql": {
          "endpoint": "http://127.0.0.1:4100/graphql",
          "operationType": "query",
          "operationName": "Query_Post",
          "query": "query Query_Post($id: ID!) {\n  post(id: $id) { id title body author { id name email role } publishedAt }\n}",
          "variablesSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "GraphQL response envelope (data/errors)."
          }
        }
      }
    },
    "/graphql/mutation/createPost": {
      "post": {
        "operationId": "graphql_mutation_createPost",
        "summary": "GraphQL mutation: createPost",
        "x-protocol": "graphql",
        "x-graphql": {
          "endpoint": "http://127.0.0.1:4100/graphql",
          "operationType": "mutation",
          "operationName": "Mutation_CreatePost",
          "query": "mutation Mutation_CreatePost($input: CreatePostInput!) {\n  createPost(input: $input) { id title body author { id name email role } publishedAt }\n}",
          "variablesSchema": {
            "type": "object",
            "properties": {
              "input": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  },
                  "authorId": {
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "body",
                  "authorId"
                ]
              }
            },
            "required": [
              "input"
            ]
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "input": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "body": {
                        "type": "string"
                      },
                      "authorId": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "title",
                      "body",
                      "authorId"
                    ]
                  }
                },
                "required": [
                  "input"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "GraphQL response envelope (data/errors).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "createPost": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "examples": [
                                "p4"
                              ]
                            },
                            "title": {
                              "type": "string",
                              "examples": [
                                "Shipped it"
                              ]
                            },
                            "body": {
                              "type": "string",
                              "examples": [
                                "The MCP + GraphQL adapters are in."
                              ]
                            },
                            "author": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "examples": [
                                    "2"
                                  ]
                                },
                                "name": {
                                  "type": "string",
                                  "examples": [
                                    "Grace Hopper"
                                  ]
                                },
                                "email": {
                                  "type": "string",
                                  "format": "email",
                                  "examples": [
                                    "grace@example.com"
                                  ]
                                },
                                "role": {
                                  "type": "string",
                                  "examples": [
                                    "MEMBER"
                                  ]
                                }
                              },
                              "required": [
                                "id",
                                "name",
                                "email",
                                "role"
                              ]
                            },
                            "publishedAt": {
                              "type": "string",
                              "format": "date-time",
                              "examples": [
                                "2026-09-07T11:33:59.086Z"
                              ]
                            }
                          },
                          "required": [
                            "id",
                            "title",
                            "body",
                            "author",
                            "publishedAt"
                          ]
                        }
                      },
                      "required": [
                        "createPost"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                },
                "examples": {
                  "capturedSample": {
                    "summary": "Captured from a live call",
                    "value": {
                      "data": {
                        "createPost": {
                          "id": "p4",
                          "title": "Shipped it",
                          "body": "The MCP + GraphQL adapters are in.",
                          "author": {
                            "id": "2",
                            "name": "Grace Hopper",
                            "email": "grace@example.com",
                            "role": "MEMBER"
                          },
                          "publishedAt": "2026-09-07T11:33:59.086Z"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}